# Copy this tracked shape into instance/live-stands/<name>.env and replace only
# non-secret installation facts. Values are shell words; do not put secrets here.
REPO_ROOT=/srv/projects/example
RELEASE_ROOT=/srv/releases/example
CURRENT_LINK=/srv/releases/example/current
SERVICE_NAME=example.service
SERVICE_ROOT_ENV=APP_ROOT
HEALTH_URL=http://127.0.0.1:3000/healthz
BUILD_COMMAND='./scripts/package-manager.sh install --frozen-lockfile && ./scripts/package-manager.sh build'
HEALTH_TIMEOUT_SECONDS=30
STALE_COMMIT_THRESHOLD=0
NOTIFY_URL=
