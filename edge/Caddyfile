{
	admin off
	http_port {$EDGE_HTTP_PORT:80}
}

{$EDGE_DOMAIN} {
	# Each file is generated by the tracked preview lifecycle tool. Preview
	# routes are path-scoped and may never claim production OAuth paths.
	import /var/lib/bpa-previews/routes/*.caddy

	# OAuth surface — an explicit allowlist. Google is unified: the service is
	# resolved from the OAuth `state`, so adding Gmail/Drive/Sheets never needs a
	# new URL registered in the Google console.
	@oauth_public path \
 /api/integrations/qbo/callback \
 /api/integrations/google/callback \
 /api/integrations/qbo/connect \
 /api/integrations/google/connect \
 /api/integrations/status

	handle @oauth_public {
		header X-BPA-Edge callback-proxy
		reverse_proxy {$APP_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	# Any OTHER /api/* path stays closed. The app answers unknown /api routes with
	# a JSON 404 itself, but the edge must not forward them at all — the allowlist
	# above is the whole API surface that is public.
	handle /api/* {
		respond 404
	}

	# The application UI. Opened 2026-07-31 because the operator could not click
	# anything: the shell existed and served on :3000 but was unreachable from
	# outside, so every review was screenshots instead of a running product.
	# This serves the SPA and its assets, with client-side routing falling back to
	# index.html so /bill and /mila resolve.
	handle {
		reverse_proxy {$APP_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}
}
