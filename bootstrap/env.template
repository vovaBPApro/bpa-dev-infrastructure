# Local operator configuration. This file is rendered to INSTALL_ROOT/.env (or
# ENV_FILE) by bootstrap/install.sh's render_environment, which creates it only
# the first time and never overwrites an existing copy. Paste the bot token
# below, then re-run the installer once later rows use it. Supported grammar:
# 6..15 decimal bot-id digits, ':', then 20..128 URL-safe characters.
# The assignment must be unique, unquoted, and start in column zero.
TELEGRAM_BOT_TOKEN=__OPERATOR_PASTE_TELEGRAM_BOT_TOKEN_HERE__

# The daemon and watchdog use these non-secret defaults once later rows render
# and activate their units; stage 1 (this row) only creates the file.
ORCH_SESSION=bpa-orchestrator
ORCH_WATCHDOG_INTERVAL=600
ORCH_RESTART_FAILURE_ALERT_AFTER=3
ORCH_LEASE_TTL_MS=1800000
FULL_SUITE_ON_CALENDAR=*-*-* 03:30:00

# Durable core state database. render_environment does not read this value;
# initialize_state_db resolves the path itself from INFRA_STATE_DB (or
# INSTALL_ROOT/runtime/state.db). Kept here as the operator-visible record of
# where it lives.
INFRA_STATE_DB=__OPERATOR_SET_ABSOLUTE_STATE_DB_PATH__
