[Unit]
Description=BPA orchestrator tmux session
After=network-online.target bpa-telegram-daemon.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=$INSTALL_ROOT
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ORCH_CONFIG_FILE=$ENV_FILE
EnvironmentFile=$ENV_FILE
ExecStart=$INSTALL_ROOT/orchestrator/launch.sh start
ExecStop=$INSTALL_ROOT/orchestrator/launch.sh stop
RemainAfterExit=yes
TimeoutStartSec=60
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
