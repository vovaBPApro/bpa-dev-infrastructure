# Copy to runtime.env or set ORCH_CONFIG_FILE to an absolute configuration path.
ORCH_PROVIDER=codex
ORCH_MODEL=gpt-5
ORCH_SESSION=orchestrator
# Durable singleton lease. The state database must already exist; otherwise
# runtime scripts continue in graceful-degrade mode and log a SKIP reason.
# ORCH_STATE_DB=/absolute/path/to/runtime/state.db
# ORCH_LEASE_TTL_MS=120000
# ORCH_LEASE_FILE=/absolute/path/to/orchestrator/runtime/orchestrator.lease
# ORCH_WORK_DIR=/absolute/path/to/repository
# ORCH_HEARTBEAT_FILE=/absolute/path/to/orchestrator-heartbeat
# ORCH_HEARTBEAT_MAX_AGE=1200
# Human-visible mission-pressure nudges. watchdog.sh is the sole atomic writer
# of this outbox; the Telegram daemon can consume completed replacements.
# NUDGE_OUTBOX_FILE=/absolute/path/to/daemon/outbox/nudges.txt
# FLEET_IDLE_NUDGE_MS=900000
# FLEET_NUDGE_REPEAT_MS=3600000
# NUDGE_RATE_FILE=/absolute/path/to/orchestrator/runtime/nudge-rate.tsv
# Nightly full local test sweep over ORCH_INSTALL_ROOT (or INSTALL_ROOT, then
# this repository). Red suites are summarized and nudged but do not make the
# systemd tick fail.
# FULL_SUITE_LOG=/absolute/path/to/orchestrator/runtime/full-suite.log
# FULL_SUITE_NUDGE_REPEAT_MS=21600000
# FULL_SUITE_NUDGE_RATE_FILE=/absolute/path/to/orchestrator/runtime/full-suite-nudge-rate.tsv
# FULL_SUITE_ON_CALENDAR=*-*-* 03:30:00
# Disk pressure is measured for ORCH_INSTALL_ROOT (or INSTALL_ROOT, then repo).
# ORCH_INSTALL_ROOT=/absolute/path/to/installation
# DISK_ALERT_PCT=80
# DECISIONS_FILE=/absolute/path/to/pending-decisions.md
# ORCH_RELAY_URL=http://127.0.0.1:4822/notify
# Morning readiness report. The Telegram daemon watches this path and sends each
# completed file silently; the orchestrator only writes the digest atomically.
# MORNING_OUTBOX_FILE=/absolute/path/to/daemon/outbox/morning.txt
# MORNING_WATERMARK_FILE=/absolute/path/to/orchestrator/runtime/morning.watermark
