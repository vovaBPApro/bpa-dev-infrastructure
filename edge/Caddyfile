{
	admin off
	http_port {$EDGE_HTTP_PORT:80}
}

{$EDGE_DOMAIN} {
	@oauth_callbacks path \
 /api/integrations/qbo/callback \
 /api/integrations/gmail/callback \
 /api/integrations/drive/callback

	handle @oauth_callbacks {
		header X-BPA-Edge callback-proxy
		reverse_proxy {$APP_UPSTREAM}
	}

	handle {
		respond 404
	}
}
