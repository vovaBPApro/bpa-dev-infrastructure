# Non-secret deployment facts for Vova's live accounting stand.
REPO_ROOT=/srv/projects/agentic-bpa
RELEASE_ROOT=/srv/releases/agentic-bpa
CURRENT_LINK=/srv/releases/agentic-bpa/current
SERVICE_NAME=agentic-bpa.service
SERVICE_ROOT_ENV=APP_ROOT
HEALTH_URL=http://127.0.0.1:3000/healthz
BUILD_COMMAND='./scripts/pnpm.sh install --frozen-lockfile && ./scripts/pnpm.sh build'
MIGRATION_PREFLIGHT_COMMAND='./scripts/deploy-migration-preflight.sh'
MIGRATION_PATH_PATTERN='(^|/)migrations?/.*\.(sql|ts|js|mjs|cjs)$'
HEALTH_TIMEOUT_SECONDS=30
POST_ACTIVATING_DELAY_SECONDS=2
STALE_COMMIT_THRESHOLD=0
MAIN_REF=origin/main
NOTIFY_URL=http://127.0.0.1:4822/notify
DEPLOY_EVENT_DIR=/var/lib/agentic-bpa/deploy-events
PROTECTED_PATH_PATTERN='(^|/)(auth|oauth|token-store|startup-preflight)(/|\.|$)|(^|/)systemd(/|$)'
