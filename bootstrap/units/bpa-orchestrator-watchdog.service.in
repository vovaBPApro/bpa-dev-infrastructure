[Unit]
Description=BPA orchestrator watchdog
After=bpa-telegram-daemon.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=$INSTALL_ROOT/orchestrator
Environment=ORCH_CONFIG_FILE=$ENV_FILE
EnvironmentFile=$ENV_FILE
ExecStart=$INSTALL_ROOT/orchestrator/watchdog.sh
NoNewPrivileges=true
PrivateTmp=true
