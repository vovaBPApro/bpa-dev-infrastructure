# Local operator configuration. This file is rendered to INSTALL_ROOT/.env and
# is deliberately ignored by the installer after its first creation.
# Paste the bot token below before re-running bootstrap/install.sh.
TELEGRAM_BOT_TOKEN=__OPERATOR_PASTE_TELEGRAM_BOT_TOKEN_HERE__

# The daemon and watchdog may use these non-secret defaults.
ORCH_SESSION=bpa-orchestrator
# Watchdog tick cadence, in seconds. This name is the one watchdog.sh and
# install-watchdog.sh actually read, and bpa-orchestrator-watchdog.timer is
# rendered from it. It used to be spelled ORCH_WATCHDOG_INTERVAL_SECONDS, which
# nothing read: the documented 600 silently never applied and installs ran the
# code default of 60 while the rendered timer carried a third, hard-coded value.
# cadence-knob.test.sh fails if this name, the readers and the timer ever
# diverge again.
ORCH_WATCHDOG_INTERVAL=600
ORCH_RESTART_FAILURE_ALERT_AFTER=3
# The watchdog is the ONLY renewer of the orchestrator lease and renews with this
# TTL, so it must OUTLIVE two ticks (2 x 600s = 1200000ms) or the lease is dead
# every time the renewer comes back and a healthy session gets fenced. Three
# ticks, matching the code default's ratio.
ORCH_LEASE_TTL_MS=1800000
# Rendered into bpa-full-suite.timer when bootstrap/install.sh runs. Override
# this environment value while rerunning the installer to change the schedule.
FULL_SUITE_ON_CALENDAR=*-*-* 03:30:00

# Durable core state database. The installer uses INSTALL_ROOT/runtime/state.db
# unless this placeholder is replaced by the operator before installation.
INFRA_STATE_DB=__OPERATOR_SET_ABSOLUTE_STATE_DB_PATH__
